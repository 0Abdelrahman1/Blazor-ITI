@page "/traineeoverview"
<h3>TraineeOverview</h3>

@code {

}

@if (InternshipContext.Trainees == null)
{
	<p><em>Loading.....</em></p>
}
else
{

	<table class="table table-striped table-info" aria-describedby="TraineeTableCaption">
		<caption id="TraineeTableCaption">List of trainees</caption>
		<thead>
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Gender</th>
				<th>Mobile</th>
				<th>Date Of Birth</th>
				<th>Track</th>
				<th>Graduated</th>
				<th>Details</th>
				<th>Edit</th>
				<th>Delete</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var trainee in InternshipContext.Trainees)
			{
				<tr>
					<td>@trainee.Name</td>
					<td>@trainee.Email</td>
					<td>@trainee.Gender</td>
					<td>@trainee.MobileNo</td>
					<td>@trainee.DateOfBirth?.ToString("yyyy-MM-dd")</td>
					<td>@trainee.Track?.Name</td>
					<td>@(trainee.IsGraduated ? "Yes" : "No")</td>
					<td><a href="@($"TraineeDetails/{trainee.Id}")" class="btn btn-info">Details</a></td>
					<td><a href="@($"TraineeEdit/{trainee.Id}")" class="btn btn-warning">Edit</a></td>
					<td><a href="@($"TraineeDelete/{trainee.Id}")" class="btn btn-danger">Delete</a></td>
				</tr>
			}
		</tbody>
	</table>
	<a href="@($"Trainee/Add")" class="btn btn-primary"> New Trainee </a>
}
