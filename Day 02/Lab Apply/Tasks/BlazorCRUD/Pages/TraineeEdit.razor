@page "/TraineeEdit/{Id:int}"
@inject NavigationManager NavigationManager

<h3>TraineeEdit</h3>

@code
{
	[Parameter]
	public int Id { get; set; }

	Trainee? EditedTrainee { get; set; }
	public bool IsSaved { get; set; } = false;
	protected override Task OnInitializedAsync()
	{
	    EditedTrainee = InternshipContext.Trainees.FirstOrDefault(t => t.Id == Id);

		return base.OnInitializedAsync();
	}

	protected void HandleValidSubmit()
    {
        IsSaved = true;
		NavigationManager.NavigateTo("/TraineeOverview");
	}

    protected void HandleInValidSubmit()
    {
		IsSaved = false;
    }
}

@if (!IsSaved)
{
    <EditForm Model="@EditedTrainee" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInValidSubmit">

        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label">Trainee ID</label>
            <label class="col-sm-10 col-form-label">@EditedTrainee.Id</label>
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label">Name</label>
            <InputText class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.Name" placeholder="Enter Name" />
            <ValidationMessage For="@(() => EditedTrainee.Name)"></ValidationMessage>
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label">Email</label>
            <InputText class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.Email" placeholder="Enter Email" />
            <ValidationMessage For="@(() => EditedTrainee.Email)"></ValidationMessage>
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label">Birth Date</label>
            <InputDate class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.DateOfBirth" placeholder="Enter Birth Date" />
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label">Phone Number</label>
            <InputText class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.MobileNo" placeholder="Enter Phone Number" />
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label"> Gender </label>
            <InputSelect class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.Gender" placeholder="Enter Gender">
                <option value="@(Gender.Male)">Male</option>
                <option value="@(Gender.Female)">Female</option>
            </InputSelect>
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label"> Graduated </label>
            <div class="col-sm-10">
                <InputCheckbox @bind-Value="EditedTrainee.IsGraduated" />
                <label class="form-check-label">Is Graduated</label>
            </div>
        </div>

        <div class="form-group-row">
            <label class="col-sm-2 col-form-label"> Track </label>
            <InputSelect class="col-sm-10 col-form-label" @bind-Value="EditedTrainee.TrackId" placeholder="Enter Track">

                @foreach (var track in InternshipContext.Tracks)
                {
                    <option value="@track.Id"> @track.Name </option>
                }

            </InputSelect>
        </div>

        <button class="btn btn-primary" type="submit"> Save Employee </button>

    </EditForm>
}